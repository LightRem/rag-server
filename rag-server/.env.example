# ==============================================================================
# Multimodal RAG Server — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and adjust the values to match your local setup.
# Configuration is parsed via Figment using the 'RAG_' prefix and '__' separator.

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
# IP address to bind the Axum web server to (e.g., 0.0.0.0 for Docker/public, 127.0.0.1 for local)
RAG_SERVER__HOST=0.0.0.0

# TCP port to listen on
RAG_SERVER__PORT=8080

# Maximum allowed size for multipart uploads and request bodies (in megabytes)
RAG_SERVER__MAX_BODY_LIMIT_MB=32

# Path where the vector store persistence snapshot will be written and read from
RAG_SERVER__SNAPSHOT_PATH=data/vector_store.json

# Interval in seconds between periodic background snapshot persistence flushes
RAG_SERVER__SNAPSHOT_INTERVAL_SECS=300

# ------------------------------------------------------------------------------
# 2. Embedding Models & ONNX Runtime Inference
# ------------------------------------------------------------------------------
# Path to the exported CLIP text ONNX model
RAG_MODEL__TEXT_MODEL_PATH=models/text_model.onnx

# Path to the exported CLIP vision ONNX model
RAG_MODEL__VISION_MODEL_PATH=models/vision_model.onnx

# Path to the Hugging Face tokenizer configuration JSON for CLIP
RAG_MODEL__TOKENIZER_PATH=models/tokenizer.json

# Number of concurrent ONNX runtime sessions per pool (CPU/GPU inference threads)
RAG_MODEL__MAX_CONCURRENCY=4

# Embedding vector dimensionality (CLIP ViT-B/32 uses 512 dimensions)
RAG_MODEL__DIMENSION=512

# ------------------------------------------------------------------------------
# 3. LLM Generation Client (OpenAI-compatible, Ollama, vLLM, or LM Studio)
# ------------------------------------------------------------------------------
# Base URL of the OpenAI-compatible chat completions endpoint
# Examples:
#   - Local Ollama:  http://localhost:11434/v1
#   - Local vLLM:    http://localhost:8000/v1
#   - OpenAI API:    https://api.openai.com/v1
RAG_LLM__ENDPOINT=http://localhost:11434/v1

# Target model identifier
# Examples: "qwen2.5:7b", "llama3.2:3b", "gpt-4o-mini"
RAG_LLM__MODEL=qwen2.5:7b

# API key for the LLM endpoint (leave blank for local Ollama/vLLM without authentication)
RAG_LLM__API_KEY=

# HTTP request timeout for LLM generation responses (in seconds)
RAG_LLM__TIMEOUT_SECS=45

# ------------------------------------------------------------------------------
# 4. Telemetry & Structured Logging
# ------------------------------------------------------------------------------
# Logging verbosity level: "trace", "debug", "info", "warn", "error"
RAG_LOGGING__LEVEL=info

# Output format for stdout and logs: "pretty" (human-readable) or "json" (structured)
RAG_LOGGING__FORMAT=pretty

# Optional file path to stream non-blocking application logs to (comment out to disable file logging)
RAG_LOGGING__FILE_PATH=data/server.log
